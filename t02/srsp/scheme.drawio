<mxfile host="app.diagrams.net"><diagram name="Количество и сумма цифр" id="digits"><mxGraphModel page="1" pageWidth="1200" pageHeight="1360"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Начало" style="rounded=1;arcSize=100;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="40" width="220" height="60" /></mxCell><mxCell id="input" value="Ввод input" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="140" width="320" height="70" /></mxCell><mxCell id="parse" value="valid = TryParse(input, out n)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="200" y="250" width="420" height="70" /></mxCell><mxCell id="valid" value="valid И n ≥ 0?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="360" width="320" height="140" /></mxCell><mxCell id="init" value="sum = 0&#10;count = 0" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="550" width="340" height="85" /></mxCell><mxCell id="body" value="sum = sum + n % 10&#10;count = count + 1&#10;n = n / 10" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="690" width="380" height="120" /></mxCell><mxCell id="loop" value="n &gt; 0?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="270" y="870" width="280" height="130" /></mxCell><mxCell id="out" value="Вывод count, sum" style="shape=parallelogram;perimeter=