<mxfile host="app.diagrams.net"><diagram name="Алгоритм Евклида" id="gcd"><mxGraphModel page="1" pageWidth="1220" pageHeight="1300"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="Начало" style="rounded=1;arcSize=100;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="40" width="220" height="60" /></mxCell><mxCell id="input" value="Ввод inputA, inputB&#10;(две строки)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="140" width="380" height="85" /></mxCell><mxCell id="parse" value="validA = TryParse(inputA, out a)&#10;validB = TryParse(inputB, out b)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="270" width="460" height="90" /></mxCell><mxCell id="valid" value="validA И validB И&#10;a ≥ 0 И b ≥ 0 И&#10;(a ≠ 0 ИЛИ b ≠ 0)?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="170" y="410" width="480" height="210" /></mxCell><mxCell id="loop" value="b ≠ 0?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="270" y="710" width="280" height="140" /></mxCell><mxCell id="body" value="r = a % b&#10;a = b&#10;b = r" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="930" width="380" height="120" /></mxCell><mxCell id="out" value="Вывод «НОД: », a" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="740" width="380" height="80" /></mxCell><mxCell id="error" value="Вывод: «Ошибка: введите два&#10;целых неотрицательных числа,&#10;не оба нуля.»" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="700" y="460" width="460" height="110" /></mxCell><mxCell id="end" value="Конец" style="rounded=1;arcSize=100;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="780" y="1180" width="220" height="60" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="start" target="input"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="input" target="parse"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="parse" target="valid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="valid" target="loop"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="valid" target="error"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="loop" target="body"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="loop" target="out"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="body" target="loop"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="80" y="990" /><mxPoint x="80" y="665" /><mxPoint x="410" y="665" /></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="out" target="end"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="error" target="end"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="515" /><mxPoint x="1180" y="1120" /><mxPoint x="890" y="1120" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>